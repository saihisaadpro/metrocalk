{
  "name": "metrocalk-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "M2.5 editor UI scaffold — a projection of the authoritative core (invariant 1), delta-fed over the M2.4 transport.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:ui-constitution": "node scripts/check-ui-constitution.mjs",
    "check:palette-contrast": "node scripts/check-palette-contrast.mjs",
    "check:first-paint": "node scripts/check-first-paint.mjs",
    "check:composite": "node scripts/check-composite.mjs",
    "check:glyph-coverage": "node scripts/check-glyph-coverage.mjs",
    "build:verify": "npm run check:ui-constitution && npm run check:palette-contrast && npm run check:first-paint && npm run check:glyph-coverage && npm run build && node scripts/check-bundle.mjs",
    "test": "vitest run",
    "test:ui-constitution": "node scripts/check-ui-constitution.mjs --self-test",
    "test:palette-contrast": "node scripts/check-palette-contrast.mjs --self-test",
    "test:first-paint": "node scripts/check-first-paint.mjs --self-test",
    "test:composite": "node scripts/check-composite.mjs --self-test",
    "test:glyph-coverage": "node scripts/check-glyph-coverage.mjs --self-test",
    "test:watch": "vitest",
    "shots": "node scripts/shots/shoot.mjs"
  },
  "dependencies": {
    "@jsonforms/core": "^3.6.0",
    "@jsonforms/react": "^3.6.0",
    "@jsonforms/vanilla-renderers": "^3.6.0",
    "@xyflow/react": "^12.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
